# Public site origin for preview and SEO links (Netlify sets URL itself; on Vercel VERCEL_PROJECT_PRODUCTION_URL wins)
URL=http://localhost:3000

# Secrets you generate, one per endpoint (openssl rand -hex 32)
SEO_SECRET_TOKEN=
DRAFT_SECRET_TOKEN=
CACHE_INVALIDATION_SECRET_TOKEN=

# DatoCMS API tokens: "CDA Only (Published)", "CDA Only (Draft)", "CMA Only (Read)"
DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN=
DATOCMS_DRAFT_CONTENT_CDA_TOKEN=
DATOCMS_CMA_TOKEN=

# Your project admin URL (https://<project>.admin.datocms.com), used by Visual Editing
DATOCMS_BASE_EDITING_URL=
